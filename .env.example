# Serverless (Vercel) environment variables

# OpenAI / Gemini
OPEN_AI_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase (server-side admin)
SUPABASE_SERVICE_ROLE_KEY=

# Optional (server-side auth verification). Defaults are hardcoded but you can override them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Token top-ups (optional tuning)
TOPUP_MIN_EUR=
TOPUP_MAX_EUR=
TOPUP_TOKENS_PER_EUR=

# API usage limits (EUR, optional)
API_DAILY_LIMIT_EUR=
API_MONTHLY_LIMIT_EUR=
API_YEARLY_LIMIT_EUR=

# Public base URL (prevents host-header injection in billing redirects)
# Example: https://mathijs.ai
APP_BASE_URL=

# Staff allowlist (comma-separated)
STAFF_EMAIL_ALLOWLIST=
STAFF_USER_ID_ALLOWLIST=
