{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/staff-dashboard",
      "destination": "/staff-dashboard.html"
    },
    {
      "source": "/customers",
      "destination": "/customers.html"
    },
    {
      "source": "/personeel",
      "destination": "/staff-team.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/boekhouding",
      "destination": "/boekhouding.html"
    },
    {
      "source": "/course-editor",
      "destination": "/course-editor.html"
    },
    {
      "source": "/course",
      "destination": "/course.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/staff-login",
      "destination": "/staff-login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/subscribe",
      "destination": "/subscribe.html"
    },
    {
      "source": "/billing-success",
      "destination": "/billing-success.html"
    },
    {
      "source": "/billing-topup-success",
      "destination": "/billing-topup-success.html"
    },
    {
      "source": "/billing-cancelled",
      "destination": "/billing-cancelled.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' https://mengrlsqgshxqcxhirjn.supabase.co wss://mengrlsqgshxqcxhirjn.supabase.co; img-src 'self' data: https://mengrlsqgshxqcxhirjn.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'sha256-yH23dwUx3B8iaZ4JuAqfKUgPVR5J3iSYV6K5zXsTDyI=' 'sha256-Ly78cNkvA0htlZFwKBTabBOH5KTY20u3WtqSRwuIBB0=' 'sha256-71alepH9cWo7BYQLVwf1GuM5PNLzLfJQ/eV+Mc4R9L4=' 'sha256-y0NyH53fTWyCHnNMvF5kOKhI5YTxMRGoJrv7hGFdq9w=' 'sha256-WBHkXOVb6V+ze+EIQUY2U49JinyZ8uHsNDJpFmQBPT4='; media-src 'self' https://commondatastorage.googleapis.com; frame-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
